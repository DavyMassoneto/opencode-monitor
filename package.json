  "description": "Monitor tool for OpenCode v2: watch a background command and wake the agent with a notification on each matching line",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "monitor",
    "agent"
  ],
  "license": "MIT",
  "author": "DavyMassoneto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavyMassoneto/opencode-monitor.git"
  },
  "homepage": "https://github.com/DavyMassoneto/opencode-monitor#readme",
  "bugs": {
    "url": "https://github.com/DavyMassoneto/opencode-monitor/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
